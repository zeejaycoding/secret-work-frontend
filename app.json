{
  "expo": {
    "name": "secret-work",
    "slug": "secret-work",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "usesApplePay": true,
      "infoPlist": {
        "NSAppleMusicUsageDescription": "We use Apple Pay to securely process your payment."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.busines2202.secretwork",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googlePay": {
          "merchantId": "",
          "merchantName": "Secret Work",
          "gateway": "stripe",
          "gatewayMerchantId": ""
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "secretwork",
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image-picker",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.secretwork",
          "urlScheme": "secretwork"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E50914"
        }
      ]
    ],
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "extra": {
      "eas": {
        "projectId": "cd218c2d-9baa-4ada-86be-c359dd507066"
      }
    }
  }
}
